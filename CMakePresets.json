{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "android32",
      "displayName": "Android 32-bit",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android32",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "armeabi-v7a",
        "ANDROID_PLATFORM": "android-23",
        "ANDROID_STL": "c++_shared",
        "GEODE_TARGET_PLATFORM": "Android32",
        "GEODE_DONT_INSTALL_MODS": "ON"
      }
    },
    {
      "name": "android64",
      "displayName": "Android 64-bit",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-23",
        "ANDROID_STL": "c++_shared",
        "GEODE_TARGET_PLATFORM": "Android64",
        "GEODE_DONT_INSTALL_MODS": "ON"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ios",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "GEODE_TARGET_PLATFORM": "iOS",
        "GEODE_DISABLE_PRECOMPILED_HEADERS": "OFF",
        "GEODE_DONT_INSTALL_MODS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android32-package",
      "configurePreset": "android32",
      "targets": ["ClickBeforeFrames_PACKAGE"]
    },
    {
      "name": "android64-package",
      "configurePreset": "android64",
      "targets": ["ClickBeforeFrames_PACKAGE"]
    },
    {
      "name": "ios-package",
      "configurePreset": "ios",
      "targets": ["ClickBeforeFrames_PACKAGE"]
    }
  ]
}
